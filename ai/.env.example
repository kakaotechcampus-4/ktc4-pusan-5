# 이 파일을 복사해서 ai/.env 를 만든다. .env 는 git 에 올라가지 않는다.
#   cp .env.example .env

# backend 와 같은 Postgres 를 본다. 기본값이 맞으면 건드릴 필요 없다.
# DATABASE_URL=postgresql+asyncpg://basis:basis@localhost:5432/basis

# 외부 호출 타임아웃(초). 네이버 증권 리서치는 인증이 없어서 API 키가 필요 없다.
# HTTP_TIMEOUT_SEC=30

# 텔레그램 수집을 실행하는 환경에서만 필요 (my.telegram.org/apps에서 발급)
# TELEGRAM_API_ID=12345
# TELEGRAM_API_HASH=your_api_hash
# 로그인 도구가 .env.telegram에 저장한다. 다른 계정의 세션을 공유하지 않는다.
# TELEGRAM_SESSION=your_string_session

# 저장된 텔레그램 본문 요약
# OPENROUTER_API_KEY=your_openrouter_key
# SUMMARY_MODEL=deepseek/deepseek-v4-flash-0731

# Elice ML API(팀 예산)로 보낼 때만 필요 (주소는 모델 페이지의 mlapi.run/<ID> 에 /v1 을 붙인다)
# LLM_PROVIDER=elice
# LLM_BASE_URL=https://mlapi.run/3fc54e02-bf9b-483e-b0d8-571ff86f04af/v1
# LLM_API_KEY=your_elice_serverless_key
# SUMMARY_MODEL=gemini-3.5-flash-lite
# SUMMARY_REASONING_EFFORT=minimal
# 모델 페이지의 1M 토큰당 **원화** 단가. Elice 는 응답에 비용을 주지 않아 이 값으로 계산하고,
# 비용도 원화로 남긴다. 모델마다 다르니 페이지에서 옮겨 적는다. 없으면 호출 전에 멈춘다.
# LLM_INPUT_KRW_PER_M=
# LLM_OUTPUT_KRW_PER_M=
# 캐시 읽기·쓰기 단가. 비우면 입력 단가로 계산한다(실제보다 비싸게 잡힌다).
# LLM_CACHE_READ_KRW_PER_M=
# LLM_CACHE_WRITE_KRW_PER_M=

# 출력 상한(추론 토큰 + 본문 합계). 기본 8000. **스트리밍 여부에 따라 받아주는 상한이 다르다.**
#   스트리밍      상한이 없다. 이 값이 그대로 출력 상한이 된다
#   비스트리밍    Elice 프록시가 2000 까지만 받는다. 2001 이상이면 호출 전부가 HTTP 400 이다
# 종목 변동 요인 보고서는 Elice 면 기본으로 스트리밍이다(아래 STOCK_ANALYSIS_STREAM).
# 리포트 요약은 비스트리밍이라, Elice 로 리포트 요약을 돌릴 때는 2000 이하로 둔다.
# SUMMARY_MAX_TOKENS=8000
# 종목 변동 요인 보고서를 스트리밍으로 받나(true/false). 비우면 Elice 일 때만 켠다.
# STOCK_ANALYSIS_STREAM=
