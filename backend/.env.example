# PostgreSQL (docker compose). 기본값으로 충분하면 건드리지 않는다.
# POSTGRES_PORT=5433        # 로컬에 이미 Postgres 가 떠 있는 경우만
# DATABASE_URL=postgresql+asyncpg://basis:basis@localhost:5432/basis

# backend/.env.example
# 이 파일을 복사해서 backend/.env 를 만들고 값을 채운다. .env 는 git 에 올라가지 않는다.
#   cp .env.example .env

# NAVER API HUB (네이버 클라우드 플랫폼 콘솔 > NAVER API HUB > Application > 인증 정보)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KIS 한국투자증권 (나중에 붙일 때 채운다)
KIS_APP_KEY=
KIS_APP_SECRET=

# DART / ECOS 
DART_API_KEY=
ECOS_API_KEY=

# 카카오 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# 자체 세션(JWT). 예: openssl rand -hex 32 로 생성
JWT_SECRET_KEY=
COOKIE_SECURE=true   # 로컬 http 개발 환경에서는 false
ENABLE_TEST_LOGIN=false   # 로컬 개발에서만 true

# 홈 주요 지수: KRX / FRED / KIS (백엔드 수집기에서만 사용)
KRX_AUTH_KEY=
KRX_API_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
FRED_API_KEY=
FRED_API_BASE_URL=https://api.stlouisfed.org/fred
KIS_ENV=real
KIS_API_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS 요청 간격(초). 신규 앱키는 3일간 한도가 낮다. 제한이 풀리면 측정 후 줄인다
KIS_REQUEST_INTERVAL_SECONDS=1.0
# 고정 목록 종목 현재가의 장중 수집 주기(초, 최소 15). 종목 수가 늘면 늘린다
STOCK_QUOTE_INTERVAL_SECONDS=60
