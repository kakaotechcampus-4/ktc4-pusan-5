# PostgreSQL (docker compose). 기본값으로 충분하면 건드리지 않는다.
# POSTGRES_PORT=5433        # 로컬에 이미 Postgres 가 떠 있는 경우만
# DATABASE_URL=postgresql+asyncpg://basis:basis@localhost:5432/basis

# backend/.env.example
# 이 파일을 복사해서 backend/.env 를 만들고 값을 채운다. .env 는 git 에 올라가지 않는다.
#   cp .env.example .env

# NAVER API HUB (네이버 클라우드 플랫폼 콘솔 > NAVER API HUB > Application > 인증 정보)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# KIS 한국투자증권 (나중에 붙일 때 채운다)
KIS_APP_KEY=
KIS_APP_SECRET=

# DART / ECOS 
DART_API_KEY=
ECOS_API_KEY=

# 카카오 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# 자체 세션(JWT). 예: openssl rand -hex 32 로 생성
JWT_SECRET_KEY=
COOKIE_SECURE=true   # 로컬 http 개발 환경에서는 false
